SmalltalkCISpec {
  #loading : [
    SCIMetacelloLoadSpec {
      #baseline : 'CalypsoOnSteroids',
      #directory : 'src',
      #load : [ 'dev' ],
      #platforms : [ #pharo ]
    }
  ],
  #testing : {
    #include : {
      #packages : [ 'Calypso-.*Tests.*', 'CalypsoOnSteroids-.*Tests.*' ]
    }
  }
}
