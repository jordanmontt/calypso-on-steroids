"
I write the board of the progress page: per area of the feature inventory, its features by tier, and from its feature sheet the scenarios, the tests they link to and the manual checks done.
"
Class {
	#name : 'CosProgressBoard',
	#superclass : 'Object',
	#instVars : [
		'areas',
		'sheets'
	],
	#category : 'CalypsoOnSteroids-Inventory',
	#package : 'CalypsoOnSteroids-Inventory'
}

{ #category : 'accessing' }
CosProgressBoard class >> committedFile [

	^ CosCheckout root / 'docs' / 'progress.md'
]

{ #category : 'instance creation' }
CosProgressBoard class >> inventory: anInventoryText sheets: aDictionary [

	^ self new setInventory: anInventoryText sheets: aDictionary
]

{ #category : 'instance creation' }
CosProgressBoard class >> ofCheckout [

	| features sheets |
	features := CosCheckout root / 'docs' / 'features'.
	sheets := Dictionary new.
	(features / 'sheets' filesMatching: '*.md') do: [ :each |
		each basename = 'README.md' ifFalse: [ sheets at: each basenameWithoutExtension put: each contents ] ].
	^ self inventory: (features / 'README.md') contents sheets: sheets
]

{ #category : 'private' }
CosProgressBoard >> labelOfManualCheck: aSymbol [

	^ {
		  (#none -> '—').
		  (#toDo -> 'to do').
		  (#done -> 'done') } asDictionary at: aSymbol
]

{ #category : 'private' }
CosProgressBoard >> manualChecksOf: features in: aSheet [

	| checks |
	checks := (features collect: [ :each | aSheet manualCheckOf: each key ]) reject: [ :each | each = #none ].
	checks ifEmpty: [ ^ '—' ].
	^ (checks count: [ :each | each = #done ]) printString , ' of ' , checks size printString
]

{ #category : 'writing' }
CosProgressBoard >> markdown [

	^ String streamContents: [ :stream |
		  self writeHeaderOn: stream.
		  self writeSummaryOn: stream.
		  self sheetAreas do: [ :each | self writeArea: each on: stream ].
		  self writeMissingTestsOn: stream ]
]

{ #category : 'writing' }
CosProgressBoard >> progressPageFrom: aString [

	^ (aString copyUpToSubstring: '## Board') , self markdown
]

{ #category : 'initialization' }
CosProgressBoard >> setInventory: anInventoryText sheets: aDictionary [

	| featureRow |
	areas := OrderedDictionary new.
	featureRow := '^\| ([A-Z]+)-(\d+) \|.*\| (M|P|X)( [^|]*)? \|$' asRegex.
	anInventoryText lines do: [ :line |
		(featureRow search: line) ifTrue: [
			(areas at: (featureRow subexpression: 2) ifAbsentPut: [ OrderedCollection new ]) add:
				(featureRow subexpression: 2) , '-' , (featureRow subexpression: 3) -> (featureRow subexpression: 4) ] ].
	sheets := aDictionary collect: [ :each | CosFeatureSheet fromText: each ]
]

{ #category : 'private' }
CosProgressBoard >> sheetAreas [

	^ areas keys select: [ :each | sheets includesKey: each ]
]

{ #category : 'private' }
CosProgressBoard >> writeArea: anArea on: aStream [

	| sheet |
	sheet := sheets at: anArea.
	aStream
		nextPutAll: '### ' , anArea;
		lf;
		lf;
		nextPutAll: '| Feature | Tier | Scenarios | With a test | Manual check |';
		lf;
		nextPutAll: '|---|---|---:|---:|---|';
		lf.
	(areas at: anArea) do: [ :feature |
		| scenarios |
		scenarios := sheet scenariosOf: feature key.
		aStream
			nextPutAll: '| ' , feature key , ' | ' , feature value , ' | ' , scenarios size printString , ' | '
				, (scenarios count: [ :each | each hasTest ]) printString , ' | '
				, (self labelOfManualCheck: (sheet manualCheckOf: feature key)) , ' |';
			lf ].
	aStream lf
]

{ #category : 'private' }
CosProgressBoard >> writeHeaderOn: aStream [

	aStream
		nextPutAll: '## Board';
		lf;
		lf;
		nextPutAll:
			'Generated by `CosProgressBoard` from the [inventory](features/README.md) and the [feature sheets](features/sheets/README.md); a test fails when it is out of date, so it is never edited by hand. To regenerate it: `CosProgressBoard ofCheckout writeTo: CosProgressBoard committedFile`.';
		lf;
		lf;
		nextPutAll:
			'Per area: its features by tier (features without a tier, dropped or out of scope, are left out), then from its sheet the scenarios, those linked to a test that exists, and the manual checks done out of those needed.';
		lf;
		lf
]

{ #category : 'private' }
CosProgressBoard >> writeMissingTestsOn: aStream [

	| missing |
	missing := self sheetAreas flatCollect: [ :each |
		           (sheets at: each) scenarios select: [ :scenario | scenario hasLink and: [ scenario hasTest not ] ] ].
	missing ifEmpty: [ ^ self ].
	aStream
		nextPutAll: 'Linked tests not found:';
		lf;
		lf.
	missing do: [ :each |
		aStream
			nextPutAll: '- `' , each testReference , '` (' , each id , ')';
			lf ].
	aStream lf
]

{ #category : 'private' }
CosProgressBoard >> writeSummaryOn: aStream [

	aStream
		nextPutAll: '| Area | Features | M | P | X | Sheet | Scenarios | With a test | Manual checks done |';
		lf;
		nextPutAll: '|---|---:|---:|---:|---:|---|---:|---:|---:|';
		lf.
	areas keysAndValuesDo: [ :area :features |
		aStream nextPutAll: '| ' , area , ' | ' , features size printString.
		#( 'M' 'P' 'X' ) do: [ :tier | aStream nextPutAll: ' | ' , (features count: [ :each | each value = tier ]) printString ].
		sheets
			at: area
			ifPresent: [ :sheet |
				aStream nextPutAll: ' | ' , sheet status , ' | ' , sheet scenarios size printString , ' | '
					, (sheet scenarios count: [ :each | each hasTest ]) printString , ' | ' , (self manualChecksOf: features in: sheet) , ' |' ]
			ifAbsent: [ aStream nextPutAll: ' | — | — | — | — |' ].
		aStream lf ].
	aStream lf
]

{ #category : 'writing' }
CosProgressBoard >> writeTo: aFileReference [

	| page |
	page := self progressPageFrom: aFileReference contents.
	aFileReference ensureDelete.
	aFileReference writeStreamDo: [ :stream | stream nextPutAll: page ]
]
